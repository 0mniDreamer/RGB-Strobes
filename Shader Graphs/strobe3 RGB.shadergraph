{
    "m_SGVersion": 1,
    "m_Type": "UnityEditor.ShaderGraph.CustomFunctionNode",
    "m_ObjectId": "e2f1c95297ed4c899ef97150680c4f1a",
    "m_Group": {
        "m_Id": ""
    },
    "m_Name": "StrobeRandomRGB (Custom Function)",
    "m_DrawState": {
        "m_Expanded": true,
        "m_Position": {
            "serializedVersion": "2",
            "x": -402.0,
            "y": 109.0,
            "width": 263.0,
            "height": 125.0
        }
    },
    "m_Slots": [
        {
            "m_Id": "4894e864ce934760919a93353d7d886b"
        },
        {
            "m_Id": "7ed6644588dd43558890a33d60e35285"
        },
        {
            "m_Id": "9d29d7aecead4319a319aa1448d212fe"
        },
        {
            "m_Id": "32a26b6c52de4128891da5f055c4e54e"
        }
    ],
    "synonyms": [
        "code",
        "HLSL"
    ],
    "m_Precision": 0,
    "m_PreviewExpanded": false,
    "m_DismissedVersion": 0,
    "m_PreviewMode": 0,
    "m_CustomColors": {
        "m_SerializableColors": []
    },
    "m_SourceType": 1,
    "m_FunctionName": "StrobeRandomRGB",
    "m_FunctionSource": "",
    "m_FunctionSourceUsePragmas": true,
    "m_FunctionBody": "// intensity/pulse from the game's driven strobe colour\nfloat intensity = max(InColor.r, max(InColor.g, InColor.b));\n\n// hold one random hue per Interval, then jump (stateless \"random that changes on a beat\")\nfloat bucket = floor(_Time.y / max(Interval, 0.0001)) + Seed;\nfloat hue = frac(sin(bucket * 12.9898) * 43758.5453);\n\n// hue -> full-sat/full-val RGB\nfloat3 rgb = saturate(abs(frac(hue + float3(0.0, 0.6667, 0.3333)) * 6.0 - 3.0) - 1.0);\n\nOut = rgb * intensity;"
}

